#!/bin/bash
# Release new changes from a subrepo (a git submodule): check them, test them, record the new commit
# in this repository, and with --push publish both, the subrepo first.
#
#   ./release-subrepo [--push] [SUBREPO]
#
# Without --push everything stays on this machine: the only effect is a commit here that moves the
# submodule pointer. SUBREPO may be left out when there is only one submodule. Commit your changes
# inside the subrepo first. The tests are `python3 -m unittest discover -s tests`, or $RELEASE_TEST.
set -o errexit
set -o nounset
set -o pipefail

die() { echo "release-subrepo: $*" >&2; exit 1; }

push=0
sub=""
for argument in "$@"; do
    case "$argument" in
        --push) push=1 ;;
        -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) die "unknown option $argument" ;;
        *) sub="${argument%/}" ;;
    esac
done

cd "$(git rev-parse --show-toplevel)"

mapfile -t subrepos < <(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')
[ ${#subrepos[@]} -gt 0 ] || die "this repository has no submodules"
if [ -z "$sub" ]; then
    [ ${#subrepos[@]} -eq 1 ] || die "name the subrepo: ${subrepos[*]}"
    sub="${subrepos[0]}"
fi
printf '%s\n' "${subrepos[@]}" | grep -qxF -- "$sub" || die "$sub is not a submodule (have: ${subrepos[*]})"
[ -e "$sub/.git" ] || die "$sub is not checked out: git submodule update --init $sub"

# Only committed work can be released, and the pointer commit should contain nothing else.
dirty=$(git -C "$sub" status --porcelain)
[ -z "$dirty" ] || die "uncommitted changes in $sub; commit them there first:"$'\n'"$dirty"
other=$(git diff --cached --name-only | grep -vxF -e "$sub" -e .gitmodules || true)
[ -z "$other" ] || die "other changes are staged; the pointer commit must contain only $sub:"$'\n'"$other"

current=$(git -C "$sub" rev-parse HEAD)
recorded=$(git ls-tree HEAD -- "$sub" 2>/dev/null | awk '{print $3}' || true)

if [ "$recorded" = "$current" ]; then
    echo "$sub: nothing new since $(git -C "$sub" rev-parse --short HEAD)"
else
    if [ -n "$recorded" ]; then
        git -C "$sub" cat-file -e "$recorded^{commit}" 2>/dev/null \
            || die "the recorded commit ${recorded:0:7} is not in $sub here; fetch it first"
        git -C "$sub" merge-base --is-ancestor "$recorded" "$current" \
            || echo "warning: $sub's history was rewritten: ${current:0:7} does not descend from ${recorded:0:7}"
        range="$recorded..$current"
    else
        range="$current"
    fi
    changes=$(git -C "$sub" log --reverse --format='- %h %s' "$range")
    echo "New in $sub:"
    echo "$changes"

    echo "Running the tests..."
    bash -c "${RELEASE_TEST:-python3 -m unittest discover -s tests}"

    git add -- "$sub"
    git commit -q -m "Update $sub to $(git -C "$sub" rev-parse --short HEAD)" -m "$changes"
    echo "Recorded $sub at $(git -C "$sub" rev-parse --short HEAD) in $(git rev-parse --short HEAD)"
fi

if [ "$push" = 1 ]; then
    # One ssh connection for both pushes, so a key passphrase is asked for once.
    if git remote get-url origin 2>/dev/null | grep -q '^git@github.com:'; then
        control="/tmp/ssh-release-subrepo-%r@%h:%p"
        ssh -o ControlMaster=yes -o ControlPath="$control" -o ControlPersist=300 -fN git@github.com
        export GIT_SSH_COMMAND="ssh -o ControlPath=$control"
        trap 'ssh -o ControlPath="$control" -O exit git@github.com 2>/dev/null || true' EXIT
    fi
    echo "Pushing $sub..."
    git -C "$sub" push
    echo "Pushing $(basename "$PWD")..."
    git push --recurse-submodules=check   # refuses if a recorded subrepo commit is not published
    echo "Released."
else
    echo "Nothing was pushed. To publish: $0 --push  (pushes $sub first, then this repository)"
fi
